# --- Accès admin (optionnel) ---
# Laisser vide = tableau de suivi accessible sans connexion (choix recette).
# Définir un mot de passe pour le protéger.
ADMIN_PASSWORD=

# --- URL publique de l'app (liens dans les emails) ---
# Hébergement prévu sous le domaine rosefestival.fr (OVH), ex. :
APP_URL=https://prestataires.rosefestival.fr

# --- Envoi d'emails depuis administration@rosefestival.fr ---
# Sans ces variables, le mailer est en "dry-run" : les emails sont loggés mais
# PAS envoyés (bouton « Email de test » dans l'admin pour vérifier).
# Boîte OVH (MX Plan / Email Pro) :
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=administration@rosefestival.fr
SMTP_PASS=
# (Si la boîte est en réalité chez Google Workspace : smtp.gmail.com + port 587
#  + mot de passe d'application.)
MAIL_FROM=administration@rosefestival.fr

# --- Google Drive + Google Sheet (classement des pièces et tableau de suivi) ---
# 1. Créer un compte de service sur console.cloud.google.com (APIs Drive + Sheets activées)
# 2. Télécharger sa clé JSON puis l'encoder :  base64 -i cle.json | pbcopy
# 3. Partager le dossier Drive dédié ET le Sheet avec l'adresse client_email du
#    compte de service (rôle Éditeur / Gestionnaire de contenu).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Id du dossier Drive racine (dans l'URL du dossier) : un sous-dossier par prestataire
GOOGLE_DRIVE_FOLDER_ID=
# Id du Google Sheet de suivi (dans l'URL du Sheet), synchronisé à chaque changement
GOOGLE_SHEET_ID=

# --- Stockage app (production Vercel) ---
# Créé automatiquement en liant un store Vercel Blob au projet.
# Sans token : stockage local dans .data/ (dev / recette).
BLOB_READ_WRITE_TOKEN=

# --- Sécurisation du cron de relance (recommandé en prod) ---
CRON_SECRET=
