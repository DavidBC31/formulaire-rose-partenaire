# --- Accès admin (Alice, Axel, David) ---
ADMIN_PASSWORD=change-moi

# --- URL publique de l'app (liens dans les emails) ---
APP_URL=https://formulaire-rose-partenaire.vercel.app

# --- Envoi d'emails depuis administration@rosefestival.fr ---
# Sans ces variables, le mailer est en "dry-run" : les emails sont loggés mais pas envoyés.
# Pour un compte Google Workspace : smtp.gmail.com + mot de passe d'application.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=administration@rosefestival.fr
SMTP_PASS=
MAIL_FROM=administration@rosefestival.fr

# --- Stockage (production Vercel) ---
# Créé automatiquement en liant un store Vercel Blob au projet.
# Sans token : stockage local dans .data/ (dev / recette).
BLOB_READ_WRITE_TOKEN=

# --- Sécurisation du cron de relance (recommandé en prod) ---
CRON_SECRET=
